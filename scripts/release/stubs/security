#!/bin/bash
# security stub for check-release-selftest.sh: answers only the read-only identity query that
# release.sh makes, with one identity named $STUB_IDENTITY, or fails with $STUB_SECURITY_STATUS.
# Anything else is refused.
echo "security $*" >>"$STUB_LOG"
if [[ $* != "find-identity -v -p codesigning" ]]; then
  echo "refused: security $*" >>"$STUB_LOG"
  exit 1
fi
if ((${STUB_SECURITY_STATUS:-0} != 0)); then
  echo "security: SecKeychainSearchCopyNext: The specified keychain could not be found." >&2
  exit "$STUB_SECURITY_STATUS"
fi
printf '  1) 0123456789ABCDEF0123456789ABCDEF01234567 "%s"\n' "$STUB_IDENTITY"
echo '     1 valid identities found'
