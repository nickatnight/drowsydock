#!/bin/bash
# xcrun stub for check-release-selftest.sh, so no run reaches the real notarytool or stapler.
#   --find TOOL            succeeds unless $STUB_MISSING names TOOL
#   notarytool submit      logs whether the zip holds DrowsyDock.app, then answers JSON with
#                          status $STUB_NOTARY_STATUS (default Accepted) and exits
#                          $STUB_SUBMIT_EXIT; STUB_NOTARY_STATUS=none fails with no JSON
#   notarytool log ID      prints a fixed issue
#   stapler staple APP     writes a ticket file into APP, or exits $STUB_STAPLE_STATUS
#   stapler validate APP   exits $STUB_VALIDATE_STATUS
# Anything else is refused.
echo "xcrun $*" >>"$STUB_LOG"
submission=2efe2717-52ef-43a5-96dc-0797e4ca1041
refuse() {
  echo "refused: xcrun $arguments" >>"$STUB_LOG"
  exit 1
}
arguments="$*"

case "$1 ${2:-}" in
  "--find "*)
    [[ $# == 2 ]] || refuse
    if [[ " ${STUB_MISSING:-} " == *" $2 "* ]]; then
      echo "xcrun: error: unable to find utility \"$2\", not a developer tool or in PATH" >&2
      exit 72
    fi
    echo "/stub/$2"
    ;;
  "notarytool submit")
    [[ $# == 8 && $4 == --keychain-profile && -n $5 && $6 == --wait && $7 == --output-format &&
      $8 == json ]] || refuse
    if zipinfo -1 "$3" 2>/dev/null | grep -qx 'DrowsyDock.app/Contents/MacOS/DrowsyDock'; then
      echo "submitted: a zip of DrowsyDock.app" >>"$STUB_LOG"
    fi
    if [[ ${STUB_NOTARY_STATUS:-} == none ]]; then
      echo "Error: HTTP status code: 401. Unable to authenticate." >&2
      exit 1
    fi
    echo "Waiting for processing to complete." >&2
    printf '{"id":"%s","message":"Processing complete","status":"%s"}\n' \
      "$submission" "${STUB_NOTARY_STATUS:-Accepted}"
    exit "${STUB_SUBMIT_EXIT:-0}"
    ;;
  "notarytool log")
    [[ $# == 5 && $3 == "$submission" && $4 == --keychain-profile && -n $5 ]] || refuse
    printf '{"status":"Invalid","issues":[{"severity":"error","message":"%s"}]}\n' \
      "STUB LOG: The signature does not include a secure timestamp."
    ;;
  "stapler staple")
    [[ $# == 3 && -d $3 ]] || refuse
    if ((${STUB_STAPLE_STATUS:-0} != 0)); then
      echo "CloudKit query for DrowsyDock.app failed due to \"Record not found\"." >&2
      exit "$STUB_STAPLE_STATUS"
    fi
    echo "a stub notarization ticket" >"$3/Contents/CodeResources"
    echo "The staple and validate action worked!"
    ;;
  "stapler validate")
    [[ $# == 3 && -d $3 ]] || refuse
    if ((${STUB_VALIDATE_STATUS:-0} != 0)); then
      echo "$3 does not have a ticket stapled to it." >&2
      exit "$STUB_VALIDATE_STATUS"
    fi
    echo "The validate action worked!"
    ;;
  *) refuse ;;
esac
