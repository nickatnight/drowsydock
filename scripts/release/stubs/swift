#!/bin/bash
# swift stub for check-release-selftest.sh, for bundle.sh's three calls: the build does nothing,
# --show-bin-path answers $STUB_BIN (which holds a fake DrowsyDock binary), and the icon render
# writes one empty PNG. Anything else is refused.
echo "swift $*" >>"$STUB_LOG"
case "$1" in
  build)
    if [[ " $* " == *" --show-bin-path "* ]]; then echo "$STUB_BIN"; fi
    ;;
  scripts/icon/render-icon.swift)
    mkdir -p "$3" && touch "$3/icon_16x16.png"
    ;;
  *)
    echo "refused: swift $*" >>"$STUB_LOG"
    exit 1
    ;;
esac
